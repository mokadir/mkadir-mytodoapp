# Server
PORT=5000
NODE_ENV=development

# Database (SQLite for local dev)
DATABASE_URL="file:./dev.db"

# For PostgreSQL in production:
# DATABASE_URL="postgresql://user:password@localhost:5432/todoapp?schema=public"

# JWT - Use a strong random string in production (at least 64 chars)
# Generate with: openssl rand -base64 64
JWT_SECRET="change-me-to-a-secure-random-string-in-production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS - Comma-separated list of allowed origins
CORS_ORIGIN="http://localhost:5173"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=10
RATE_LIMIT_MAX_GENERAL=100
